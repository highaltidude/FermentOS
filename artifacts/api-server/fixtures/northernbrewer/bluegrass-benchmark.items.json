  {"str":"ON BREWING DAY","x":33.6,"y":41.5,"width":75.6,"height":10},
  {"str":"1.","x":31.5,"y":61.6,"width":10.5,"height":9},
  {"str":"Heat 2.5 gal of water.","x":49.5,"y":61.6,"width":113.1,"height":9},
  {"str":"2.","x":31.5,"y":77.1,"width":10.5,"height":9},
  {"str":"Pour grain into supplied mesh bag, and tie open","x":49.5,"y":77.1,"width":241.4,"height":9},
  {"str":"end in a knot. Steep for 30 min at 150° - 160°F.","x":49.5,"y":88.1,"width":246.5,"height":9},
  {"str":"Remove bag, drain and discard.","x":49.5,"y":99.1,"width":154.2,"height":9},
  {"str":"3.","x":31.5,"y":113.6,"width":10.5,"height":9},
  {"str":"Bring to a boil. Remove the kettle from burner","x":49.5,"y":113.6,"width":236.3,"height":9},
  {"str":"and stir in","x":49.5,"y":123.6,"width":56.7,"height":9},
  {"str":"3.15 lbs Gold Malt Syrup","x":111,"y":123.6,"width":123.4,"height":9},
  {"str":", and","x":234.1,"y":123.6,"width":25.9,"height":9},
  {"str":"1 lb","x":264.8,"y":123.6,"width":20.8,"height":9},
  {"str":"Golden Light DME","x":49.5,"y":133.6,"width":82.4,"height":9},
  {"str":".","x":131.5,"y":133.6,"width":5.4,"height":9},
  {"str":"4.","x":31.5,"y":149.1,"width":10.5,"height":9},
  {"str":"Return to boil. The mixture is now called","x":49.5,"y":149.1,"width":210.6,"height":9},
  {"str":"“wort”, the brewer’s term for unfermented beer.","x":49.5,"y":160.1,"width":241.4,"height":9},
  {"str":"NOTE:","x":49.5,"y":171.1,"width":25.9,"height":9},
  {"str":"Total boil time is 60 min.","x":80.3,"y":171.1,"width":133.6,"height":9},
  {"str":"-","x":45,"y":186.6,"width":5.4,"height":9},
  {"str":"Add 0.5 oz Cluster","x":54,"y":186.6,"width":91.2,"height":9},
  {"str":"at the beginning of the boil.","x":149.9,"y":186.6,"width":146.8,"height":9},
  {"str":"-","x":45,"y":202.1,"width":5.4,"height":9},
  {"str":"Add 0.5 oz Cluster","x":54,"y":202.1,"width":91.2,"height":9},
  {"str":"with 15 minutes remaining in","x":149.9,"y":202.1,"width":141.7,"height":9},
  {"str":"the boil.","x":54,"y":213.1,"width":45.8,"height":9},
  {"str":"-","x":45,"y":228.6,"width":5.4,"height":9},
  {"str":"Add 0.5 oz Tettnang","x":54,"y":228.6,"width":96.3,"height":9},
  {"str":"and","x":154.9,"y":228.6,"width":15.5,"height":9},
  {"str":"32 fl oz Corn Syrup","x":175.1,"y":228.6,"width":91.2,"height":9},
  {"str":"with","x":271,"y":228.6,"width":20.5,"height":9},
  {"str":"0 minutes remaining in the boil.","x":54,"y":239.6,"width":161.9,"height":9},
  {"str":"5.","x":31.5,"y":254.1,"width":10.5,"height":9},
  {"str":"Remove kettle from the burner and cool wort.","x":49.5,"y":254.1,"width":226,"height":9},
  {"str":"When the 60 minute boil is finished, cool wort to","x":49.5,"y":264.1,"width":246.5,"height":9},
  {"str":"approximately 65°-70","x":49.5,"y":274.1,"width":102.9,"height":9},
  {"str":"°","x":152,"y":274.1,"width":4.4,"height":9},
  {"str":"F as rapidly as possible.","x":156.2,"y":274.1,"width":128.5,"height":9},
  {"str":"Use a wort chiller, or put kettle in an ice bath","x":49.5,"y":284.1,"width":246.5,"height":9},
  {"str":"in your sink.","x":49.5,"y":294.1,"width":67,"height":9},
  {"str":"6.","x":315,"y":61.6,"width":10.5,"height":9},
  {"str":"Sanitize fermenting equipment and yeast pack.","x":333,"y":61.6,"width":231.1,"height":9},
  {"str":"While wort cools, sanitize fermenting equipment","x":333,"y":71.6,"width":241.4,"height":9},
  {"str":"(fermentor, lid or stopper, airlock, funnel,","x":333,"y":81.6,"width":226,"height":9},
  {"str":"etc) along with yeast pack.","x":333,"y":91.6,"width":138.8,"height":9},
  {"str":"7.","x":315,"y":106.1,"width":10.5,"height":9},
  {"str":"Fill primary fermentor with 2 gal cold water,","x":333,"y":106.1,"width":231.1,"height":9},
  {"str":"then pour in cooled wort. Leave any thick sludge","x":333,"y":116.1,"width":246.5,"height":9},
  {"str":"in bottom of kettle.","x":333,"y":126.1,"width":102.9,"height":9},
  {"str":"8.","x":315,"y":140.6,"width":10.5,"height":9},
  {"str":"Add more cold water as needed to bring volume","x":333,"y":140.6,"width":231.1,"height":9},
  {"str":"to 5 gal.","x":333,"y":150.6,"width":46.4,"height":9},
  {"str":"9.","x":315,"y":165.1,"width":10.5,"height":9},
  {"str":"Aerate wort: Seal fermentor and rock back and","x":333,"y":165.1,"width":231.1,"height":9},
  {"str":"forth to splash for a few mins, or use an","x":333,"y":175.1,"width":210.6,"height":9},
  {"str":"aeration system and diffusion stone.","x":333,"y":185.1,"width":185,"height":9},
  {"str":"10.","x":315,"y":199.6,"width":15.7,"height":9},
  {"str":"Measure the wort’s specific gravity with a","x":333,"y":199.6,"width":210.6,"height":9},
  {"str":"hydrometer. Record.","x":333,"y":209.6,"width":97.7,"height":9},
  {"str":"11.","x":315,"y":224.1,"width":15.7,"height":9},
  {"str":"Add yeast once temperature of the wort is","x":333,"y":224.1,"width":210.6,"height":9},
  {"str":"70°F or lower. Sanitize and open yeast pack.","x":333,"y":234.1,"width":226,"height":9},
  {"str":"Carefully pour contents into primary fermentor.","x":333,"y":244.1,"width":241.4,"height":9},
  {"str":"12.","x":315,"y":258.6,"width":15.7,"height":9},
  {"str":"Seal fermentor. Add approx. 1 tbsp of water to","x":333,"y":258.6,"width":236.3,"height":9},
  {"str":"sanitized fermentation lock. Insert airlock into","x":333,"y":268.6,"width":246.5,"height":9},
  {"str":"rubber stopper or lid.","x":333,"y":278.6,"width":113.1,"height":9},
  {"str":"13.","x":315,"y":293.1,"width":15.7,"height":9},
  {"str":"Move fermentor to a cool, dark, quiet spot until","x":333,"y":293.1,"width":246.5,"height":9},
  {"str":"fermentation begins.","x":333,"y":303.1,"width":102.9,"height":9},
  {"str":"PRIMARY FERMENTATION","x":33.6,"y":340.9,"width":110.6,"height":10},
  {"str":"14.","x":31.5,"y":357.3,"width":15.7,"height":9},
  {"str":"Within 48 hours","x":49.5,"y":357.3,"width":77.2,"height":9},
  {"str":"Active fermentation begins.","x":131.5,"y":357.3,"width":138.8,"height":9},
  {"str":"You’ll see a cap of foam on the surface of","x":49.5,"y":368.3,"width":215.7,"height":9},
  {"str":"the beer. Specific gravity as measured with","x":49.5,"y":379.3,"width":215.7,"height":9},
  {"str":"a hydrometer will drop steadily. You may see","x":49.5,"y":390.3,"width":226,"height":9},
  {"str":"bubbles in the fermentation lock. The optimum","x":49.5,"y":401.3,"width":231.1,"height":9},
  {"str":"temp. for this beer is 65°- 70°F.","x":49.5,"y":412.3,"width":169.6,"height":9},
  {"str":"15.","x":31.5,"y":427.8,"width":15.7,"height":9},
  {"str":"Within 2 weeks","x":49.5,"y":427.8,"width":72.1,"height":9},
  {"str":"Active fermentation ends.","x":126.4,"y":427.8,"width":128.5,"height":9},
  {"str":"Proceed to next step when:","x":49.5,"y":442.3,"width":133.6,"height":9},
  {"str":"-","x":45,"y":456.8,"width":5.4,"height":9},
  {"str":"Cap of foam falls back into the beer.","x":54,"y":456.8,"width":190.1,"height":9},
  {"str":"-","x":45,"y":471.3,"width":5.4,"height":9},
  {"str":"Bubbling in airlock slows down or stops.","x":54,"y":471.3,"width":205.5,"height":9},
  {"str":"-","x":45,"y":485.8,"width":5.4,"height":9},
  {"str":"Specific gravity as measured with a hydrometer","x":54,"y":485.8,"width":231.1,"height":9},
  {"str":"is stable.","x":54,"y":496.8,"width":51.6,"height":9},
  {"str":"BOTTLING DAY (","x":317.2,"y":340.9,"width":69.1,"height":10},
  {"str":"ABOUT 4 WEEKS AFTER BREWING DAY)","x":386.3,"y":340.9,"width":166.3,"height":10},
  {"str":"NOTE:","x":31.6,"y":536,"width":25.9,"height":9},
  {"str":"You may skip transferring to a secondary","x":62.4,"y":536,"width":205.5,"height":9},
  {"str":"fermentor and simply leave the beer in the primary","x":31.6,"y":547,"width":256.8,"height":9},
  {"str":"fermentor.","x":31.6,"y":558,"width":51.6,"height":9},
  {"str":"16.","x":31.6,"y":573.5,"width":15.7,"height":9},
  {"str":"Sanitize siphoning equipment, airlock, carboy","x":49.6,"y":573.5,"width":231.1,"height":9},
